# Copy to server /opt/miningintel/.env; do not commit the filled file.
APP_ENV=production
POSTGRES_USER=miningintel
POSTGRES_DB=miningintel
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_DATABASE_PASSWORD
SECRET_KEY=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
DATABASE_URL=postgresql+asyncpg://miningintel:unused@postgres:5432/miningintel
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
ML_ENABLED=false
INSTALL_ML=false
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
FETCH_DISTRIBUTED_PACING=true
USER_AGENT=MiningIntel/0.1 (+mailto:REPLACE_WITH_CONTACT_EMAIL)
SEC_USER_AGENT=
RATE_LIMIT_BACKEND=redis
AUTO_PUBLISH=false
PUBLISH_QUALITY_THRESHOLD=70
GATEWAY_BIND=0.0.0.0
GATEWAY_PORT=3030
PROMETHEUS_PORT=9091
PUBLIC_SITE_URL=http://8.156.66.169:3030
CORS_ORIGINS=["http://8.156.66.169:3030"]
WORKER_CONCURRENCY=1
DIGEST_TIMEZONE=Asia/Shanghai
LOG_DIR=/var/log/miningintel
LOG_RETENTION_DAYS=14
TASK_HISTORY_DAYS=7
TASK_HISTORY_LIMIT=10000
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_RANDOM_GRAFANA_PASSWORD
EMAIL_NOTIFICATIONS_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
SMTP_SSL=false
WEBHOOK_NOTIFICATIONS_ENABLED=false
SLACK_WEBHOOK_URL=
FEISHU_WEBHOOK_URL=
FEISHU_WEBHOOK_SECRET=
WECOM_WEBHOOK_URL=
BACKUP_ENABLED=false
BACKUP_TIMEZONE=Asia/Shanghai
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=https://oss-cn-chengdu.aliyuncs.com
BACKUP_S3_PREFIX=miningintel/postgres
BACKUP_S3_ADDRESSING_STYLE=virtual
AWS_DEFAULT_REGION=cn-chengdu
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
