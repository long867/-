# Copy to .env in the monorepo root. The gateway is http://localhost:8080.
APP_ENV=development
POSTGRES_USER=miningintel
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_DB=miningintel
DATABASE_URL=postgresql+asyncpg://miningintel:change-this-local-password@postgres:5432/miningintel
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=miningintel_articles
QDRANT_TIMEOUT=10
LLM_API_KEY=
LLM_BASE_URL=https://api.example.com/v1
LLM_MODEL=configure-your-model
LLM_EXTRA_BODY={}
LLM_TIMEOUT=90
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
ML_ENABLED=false
ML_DEVICE=cpu
MODEL_CACHE_DIR=
RATE_LIMIT_BACKEND=redis
API_RATE_LIMIT=120/minute
CACHE_ENABLED=true
DIGEST_TIMEZONE=Asia/Shanghai
EMAIL_NOTIFICATIONS_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
SMTP_SSL=false
PUBLIC_SITE_URL=http://localhost:3000
# Robot webhook URLs are secrets. Enabling sends to the configured channels.
WEBHOOK_NOTIFICATIONS_ENABLED=false
SLACK_WEBHOOK_URL=
FEISHU_WEBHOOK_URL=
FEISHU_WEBHOOK_SECRET=
WECOM_WEBHOOK_URL=
# Local single-process preview without Redis may explicitly choose memory.
# APP_ENV=production rejects memory; Celery still requires Redis.
# Set INSTALL_ML=true and ML_ENABLED=true together to install and enable BGE.
INSTALL_ML=false
FETCH_INTERVAL=900
FETCH_TIMEOUT=30
FETCH_MAX_BYTES=5000000
FETCH_RETRIES=3
# Optional DoH bootstrap for networks with intercepted DNS; connect to checked IPs.
# Example: https://1.1.1.1/dns-query. Empty uses system DNS.
FETCH_DNS_RESOLVER=
# Enable for every multi-worker deployment; mandatory in APP_ENV=production.
FETCH_DISTRIBUTED_PACING=true
TRANSLATION_CHUNK_SIZE=4000
# Optional locally installed spaCy model, e.g. en_core_web_sm.
SPACY_MODEL=
# Full body translation, or validated Chinese title/summary on a small server.
ENRICHMENT_MODE=full
ENTITY_MATCHER=spacy
# SEC public APIs need an identifying User-Agent with a real contact address.
SEC_USER_AGENT=
FETCH_PROXY=
# Optional system browser channel on Windows; Linux containers use Chromium.
FETCH_BROWSER_CHANNEL=
FASTMARKETS_API_TOKEN=
ARGUS_API_TOKEN=
USER_AGENT=MiningIntel/0.1 (+https://example.com/contact)
SECRET_KEY=dev-only-change-this-32-character-secret
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]
ACCESS_TOKEN_MINUTES=60
AUTO_PUBLISH=false
PUBLISH_QUALITY_THRESHOLD=70
EVENT_SIMILARITY_THRESHOLD=0.86
RAG_TOP_K=5
RAG_CANDIDATES=20
RAG_RERANK_CANDIDATES=20
INDEX_BATCH_SIZE=100
PRICE_ALERT_THRESHOLD=3
LOG_LEVEL=INFO
GRAFANA_ADMIN_PASSWORD=change-this-grafana-password
GATEWAY_PORT=8080
GATEWAY_BIND=127.0.0.1
WORKER_CONCURRENCY=1
LOG_DIR=artifacts/logs
LOG_RETENTION_DAYS=14
TASK_HISTORY_DAYS=7
TASK_HISTORY_LIMIT=10000
# Enable the backup Compose profile after filling the object-storage credentials.
BACKUP_ENABLED=false
BACKUP_TIMEZONE=Asia/Shanghai
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
BACKUP_S3_PREFIX=miningintel/postgres
BACKUP_S3_ADDRESSING_STYLE=virtual
BACKUP_S3_ENCRYPTION=
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Only explicitly staged historical originals use this threshold.
INITIALIZATION_QUALITY_THRESHOLD=50
