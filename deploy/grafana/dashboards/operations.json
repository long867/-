    },
    {
      "id": 11,
      "title": "任务执行状态",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "miningintel-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (task,state) (increase(miningintel_task_runs_total[1h]))",
          "legendFormat": "{{source}}{{mineral}}{{status}}{{task}}{{state}}{{route}}"
        }
