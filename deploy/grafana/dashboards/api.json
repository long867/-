{
  "title": "MiningIntel API", "uid": "miningintel-api", "schemaVersion": 40, "version": 1,
  "time": {"from": "now-1h", "to": "now"}, "refresh": "30s",
  "panels": [
    {"id": 1, "type": "timeseries", "title": "Requests / second by route", "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "miningintel-prometheus"}, "targets": [{"expr": "sum by (route) (rate(miningintel_http_requests_total[5m]))", "legendFormat": "{{route}}", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "reqps"}}},
    {"id": 2, "type": "timeseries", "title": "API p95 latency (seconds)", "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "miningintel-prometheus"}, "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(miningintel_http_duration_seconds_bucket[5m])))", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "s"}}},
    {"id": 3, "type": "stat", "title": "5xx error ratio", "gridPos": {"x": 0, "y": 8, "w": 12, "h": 5}, "datasource": {"type": "prometheus", "uid": "miningintel-prometheus"}, "targets": [{"expr": "sum(rate(miningintel_http_requests_total{status=~\"5..\"}[5m])) / clamp_min(sum(rate(miningintel_http_requests_total[5m])), 0.001)", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "percentunit"}}}
  ]
}
