        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le,task) (rate(miningintel_task_duration_seconds_bucket[15m])))",
          "legendFormat": "{{source}}{{mineral}}{{status}}{{task}}{{state}}{{route}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
