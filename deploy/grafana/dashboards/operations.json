      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le,route) (rate(miningintel_http_duration_seconds_bucket[5m])))",
          "legendFormat": "{{source}}{{mineral}}{{status}}{{task}}{{state}}{{route}}"
        }
      ],
      "fieldConfig": {
